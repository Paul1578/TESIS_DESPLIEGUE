#########################################################
# Mayan EDMS 4.11.5 - despliegue de preproduccion
# 1) cp .env.example .env
# 2) Definir MAYAN_SECRET_KEY y MAYAN_AUTOADMIN_PASSWORD
# 3) docker compose up -d --build
#########################################################

# --- Seguridad (obligatorio) ---
# Genera con: openssl rand -base64 64
MAYAN_SECRET_KEY=

# --- Admin inicial (creado automaticamente en el primer arranque) ---
MAYAN_AUTOADMIN_USERNAME=admin
MAYAN_AUTOADMIN_PASSWORD=
MAYAN_AUTOADMIN_EMAIL=admin@example.com

# --- Acceso HTTP ---
# Puerto LAN del nginx (acceso directo por IP, sin pasar por Traefik).
MAYAN_HTTP_PORT=1987

# --- Dominio publico (via Traefik integrado) ---
# Subdominio/dominio para emitir el certificado HTTPS, ej. herramientagde.byronrm.com
# Si lo dejas VACIO, no se emite certificado y el acceso es solo por LAN
# (http://IP:MAYAN_HTTP_PORT).
MAYAN_DOMAIN=
# Correo para Let's Encrypt (obligatorio si MAYAN_DOMAIN esta definido).
ACME_EMAIL=
# Puertos host del Traefik. Cambialos si el servidor ya usa 80/443.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
LOG_LEVEL=INFO

# --- Imagen (opcional) ---
# Por defecto usa la imagen de GHCR del pipeline. Solo cambiala si queres
# fijar un tag especifico (ej. un SHA) o probar local con otra imagen.
# MAYAN_IMAGE=ghcr.io/paul1578/mayan-edms-preprod:latest

# --- PostgreSQL ---
MAYAN_DATABASE_NAME=mayan
MAYAN_DATABASE_USER=mayan
MAYAN_DATABASE_PASSWORD=mayandbpass
MAYAN_DATABASE_HOST=postgresql

# --- Redis (broker de celery) ---
MAYAN_REDIS_PASSWORD=mayanredispassword

# --- Idioma / zona horaria ---
MAYAN_LANGUAGE_CODE=es
MAYAN_TIME_ZONE=America/Guayaquil

# --- OCR en español ---
# Instala el idioma de Tesseract al arrancar (sin reconstruir la imagen).
MAYAN_APT_INSTALLS=tesseract-ocr-spa
MAYAN_OCR_LANGUAGE=spa

# --- Ingesta por carpeta (Watch Folder) ---
# Ruta en el HOST donde caen los PDFs del escaner. Se monta dentro del
# contenedor en /var/lib/mayan/watch_folder. Crea la fuente por la UI una vez.
WATCH_FOLDER=/mnt/escaner

# --- Confianza CSRF ---
# Origenes que el navegador usa al entrar. Incluye el dominio publico y el
# acceso LAN. Ej:
# MAYAN_CSRF_TRUSTED_ORIGINS=['https://herramientagde.byronrm.com', 'http://192.168.1.50:1987']

# --- Dependencias a esperar en el arranque ---
MAYAN_DOCKER_WAIT=postgresql:5432 redis:6379 mailpit:1025

# --- Email ---
# Test: usa Mailpit (SMTP de prueba). Los correos NO se envian a nadie real;
# se capturan y se ven en http://<servidor>:8025
# Produccion con Gmail: descomenta, reemplaza las variables y pon tu
# PASSWORD DE APLICACION (16 caracteres, se genera en la cuenta de Google
# activando la verificacion en 2 pasos). Tu password normal NO funciona.
MAYAN_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAYAN_EMAIL_HOST=mailpit
MAYAN_EMAIL_PORT=1025
MAYAN_EMAIL_USE_TLS=false
MAYAN_EMAIL_HOST_USER=
MAYAN_EMAIL_HOST_PASSWORD=
MAYAN_DEFAULT_FROM_EMAIL=mayan@localhost

# Gmail (produccion):
# MAYAN_EMAIL_HOST=smtp.gmail.com
# MAYAN_EMAIL_PORT=587
# MAYAN_EMAIL_USE_TLS=true
# MAYAN_EMAIL_HOST_USER=tucorreo@gmail.com
# MAYAN_EMAIL_HOST_PASSWORD=password-de-aplicacion-de-16-digitos
# MAYAN_DEFAULT_FROM_EMAIL=tucorreo@gmail.com